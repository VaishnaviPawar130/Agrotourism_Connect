PORT=5000
MONGODB_URI=mongodb://localhost:27017/agrotourism_connect

# REQUIRED in production: a long, random, unique value.
# The server refuses to start in production if this is unset, left at the
# development default, or shorter than 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret

JWT_EXPIRES_IN=7d

# Allowed browser origin(s) for CORS. Comma-separate to allow more than one.
CLIENT_URL=http://localhost:5173

UPLOAD_DIR=uploads

# Set to "production" for a real deployment. This enables the strict JWT_SECRET
# check and stops error responses from including internal error details.
NODE_ENV=development
